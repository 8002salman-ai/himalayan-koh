# Supabase Configuration
# https://app.supabase.com/project/_/settings/api

VITE_SUPABASE_URL=https://your-project-id.supabase.co
# New publishable key (sb_publishable_...) or legacy anon JWT
VITE_SUPABASE_ANON_KEY=sb_publishable_your-key-here

# Server-side only. Never commit real values.
# New secret key (sb_secret_...) or legacy service_role JWT
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-key-here

# Direct Postgres connection (Settings > Database > Connection string > URI)
# Required for npm run setup:supabase (migrations + product seed)
SUPABASE_DB_URL=postgresql://postgres.[project-ref]:[YOUR-DB-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Stripe placeholders (prepared, not active)
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=

# OpenRouter AI assistant (server-side only)
OPENROUTER_API_KEY=
# Optional override; defaults to DeepSeek free, then Qwen free fallback.
OPENROUTER_MODEL=

# Optional — client error monitoring (install @sentry/react when enabling)
# VITE_SENTRY_DSN=
# VITE_APP_ENV=production

# Build — leave unset for normal Vercel production builds (chunked assets)
# VITE_SINGLE_FILE=true
